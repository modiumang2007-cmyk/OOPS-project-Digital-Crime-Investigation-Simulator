@startuml use-case-diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Admin
actor "Cyber Investigator" as CyberInvestigator
actor "Field Investigator" as FieldInvestigator
actor "File System" as FileSystem <<external system>>

rectangle "CaseFile System" {
  usecase "Create Case" as UC1
  usecase "Assign Investigator" as UC2
  usecase "Add Evidence" as UC3
  usecase "Analyze Evidence" as UC4
  usecase "Escalate Case" as UC5
  usecase "Save Case Data" as UC6
  usecase "Search Records" as UC7
  usecase "Generate Report" as UC8
  usecase "Close Case" as UC9
  usecase "Load Case Data" as UC10
}

Admin -- UC1
Admin -- UC2
Admin -- UC7
Admin -- UC8
Admin -- UC9

CyberInvestigator -- UC3
CyberInvestigator -- UC4
CyberInvestigator -- UC7
CyberInvestigator -- UC8

FieldInvestigator -- UC3
FieldInvestigator -- UC4
FieldInvestigator -- UC7
FieldInvestigator -- UC8

FileSystem -- UC6
FileSystem -- UC10

UC9 ..> UC8 : <<include>>
UC3 ..> UC6 : <<include>>
UC5 ..> UC4 : <<extend>>\n[evidence marked critical]

@enduml
