}

' -- Investigator (inherited: investigatorId, name, activeCaseload) --

object "investigator1 : FieldInvestigator" as investigator1 {
  investigatorId = "INV-01"
  name = "Priya Sharma"
  activeCaseload = 3
}

object "investigator2 : CyberInvestigator" as investigator2 {
  investigatorId = "INV-02"
  name = "Arjun Patel"
  activeCaseload = 2
}

object "witness1 : Witness" as witness1 {
  witnessId = "W-01"
  name = "Kavita Rao"
  statementMetadata = "Recorded 2026-07-11"
}

object "suspect1 : Suspect" as suspect1 {
  suspectId = "S-01"
