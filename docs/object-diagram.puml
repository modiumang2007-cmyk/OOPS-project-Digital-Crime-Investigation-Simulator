}

' ---------------- Links (from class-diagram associations) ----------------

admin1 --> case1 : creates
admin1 --> investigator1 : assigns
admin1 --> investigator2 : assigns

case1 --> investigator1 : "assigned to"
case1 --> investigator2 : "assigned to"
case1 --> witness1 : involves
case1 --> suspect1 : involves
case1 --> evidence1 : contains
case1 --> evidence2 : contains
case1 --> testimonial1 : contains
case1 --> report1 : produces

investigator1 --> evidence1 : analyzes
