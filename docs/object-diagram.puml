' Snapshot instance for Case C2026-045 (Warehouse Burglary)
' All attributes shown, including those inherited from
' abstract superclasses (Evidence, Investigator).
' ============================================================

skinparam backgroundColor white
skinparam object {
  BackgroundColor #EAF1FB
  BorderColor #1A1A1A
  FontName Helvetica
  FontSize 12
  FontStyle bold
}
skinparam ArrowColor #333333
skinparam ArrowFontSize 11
skinparam ArrowFontStyle italic
skinparam ArrowFontColor #444444

' ---------------- Objects ----------------

object "admin1 : Admin" as admin1 {
  adminId = "A101"
  name = "Officer Raj Mehta"
}

object "case1 : Case" as case1 {
  caseId = "C2026-045"
